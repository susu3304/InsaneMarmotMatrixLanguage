{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "insane marmot matrix",
  "scopeName": "source.imm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#entrypoints"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#members"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#parameters"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.imm",
          "match": "#.*$"
        },
        {
          "name": "comment.block.imm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.imm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.imm",
              "match": "\\\\[nt\"\\\\]"
            },
            {
              "name": "invalid.illegal.escape.imm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.imm",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.imm",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "entrypoints": {
      "patterns": [
        {
          "name": "meta.function.entrypoint.imm",
          "match": "\\b(?:(insane|howl)\\s+)?(marmot)\\s+(main)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.imm"
            },
            "2": {
              "name": "keyword.control.entrypoint.imm"
            },
            "3": {
              "name": "entity.name.function.imm"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(howl\\s+)?(dig)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.async.imm"
            },
            "2": {
              "name": "keyword.declaration.function.imm"
            },
            "3": {
              "name": "entity.name.function.imm"
            }
          }
        },
        {
          "match": "\\b(den|mask)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.imm"
            },
            "2": {
              "name": "entity.name.type.imm"
            }
          }
        },
        {
          "match": "\\b(let|stash)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.imm"
            },
            "2": {
              "name": "variable.other.imm"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.imm",
          "match": "\\b(?:Int|Float|Bool|String|Array|Matrix|Point|Null|Void|Task|TaskGroup|Response|WebApp|App|Router|Burrow|Context|Request|Server|Middleware|Map)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.imm",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.imm",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.imm",
          "match": "\\b(?:self|under)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.imm",
          "match": "\\b(?:if|else|for|in|while|break|continue|return|try|catch|tunnel|choose)\\b"
        },
        {
          "name": "keyword.declaration.imm",
          "match": "\\b(?:marmot|dig|let|stash|den|hatch|mask|wear|fur|fang|init|burrow|use|pack|crate|pelt|probe|law)\\b"
        },
        {
          "name": "storage.modifier.imm",
          "match": "\\b(?:insane|howl)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.imm",
          "match": "\\b(?:squeak|sniff|panic|trace|wait|scatter|nest|nap|expect|map|filter|reduce|len|type|str|int|float|bool|width|height|in_bounds|points|neighbors4|neighbors8|find|find_all|bfs|astar|direction|step|parse_field|safe_moves|random_move|open|save|load|all|get|delete|count|clear|grab|fetch|now|den|app|burrow|router|release|peek|listen|response|json|text|html|shiny|bytes|pelt|redirect|scurry|empty|lost|recover|cors|limit|stash|replace|patch|erase|ask|nod|any|wear|dig|hoard|rescue|params|query|paws|trail|pouch|crack|form)\\b"
        },
        {
          "name": "support.module.imm",
          "match": "\\b(?:core|math|path|chaser|store|web|tick)\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.imm"
            },
            "2": {
              "name": "entity.name.function.member.imm"
            }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.imm"
            },
            "2": {
              "name": "variable.other.property.imm"
            }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.imm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.imm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.imm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.imm",
          "match": "=>|->|\\.\\.|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=!<>.@:]"
        }
      ]
    }
  }
}
